@inherits SayfaTabani

<SayfaBasligi Baslik="Eşleşmelerim" Aciklama="Gelen istekleri yanıtla. İki taraf da kabul edince iletişim bilgileri görünür ve mesajlaşabilirsiniz." />

<Uyari Hata="@Hata" Bilgi="@Bilgi" />

@if (_listeler is not null)
{
    <h2 class="bolum">Gelen istekler (@_listeler.GelenIstekler.Count)</h2>
    @foreach (var e in _listeler.GelenIstekler)
    {
        <KisiKarti Ad="@e.AdSoyad" Satirlar="@Satirlar(e)" Uyum="e.UyumYuzdesi">
            <Eylemler>
                <button class="birincil" disabled="@Mesgul" @onclick="() => Yanitla(e, true)">Kabul et</button>
                <button class="ikincil" disabled="@Mesgul" @onclick="() => Yanitla(e, false)">Reddet</button>
            </Eylemler>
        </KisiKarti>
    }
    @if (_listeler.GelenIstekler.Count == 0)
    {
        <div class="bos">Yanıt bekleyen istek yok.</div>
    }

    <h2 class="bolum">Gönderdiğim istekler (@_listeler.GonderilenIstekler.Count)</h2>
    @foreach (var e in _listeler.GonderilenIstekler)
    {
        <KisiKarti Ad="@e.AdSoyad" Satirlar="@Satirlar(e)" Uyum="e.UyumYuzdesi">
            <Eylemler>
                @if (e.Durum == EslesmeDurumu.Red)
                {
                    <span class="durum red">Reddedildi</span>
                }
                else
                {
                    <span class="durum bekliyor">Yanıt bekleniyor</span>
                    <button class="ikincil" disabled="@Mesgul" @onclick="() => GeriCek(e)">Geri çek</button>
                }
            </Eylemler>
        </KisiKarti>
    }
    @if (_listeler.GonderilenIstekler.Count == 0)
    {
        <div class="bos">Gönderdiğin istek yok. Arkadaş bul sayfasından istek gönderebilirsin.</div>
    }

    <h2 class="bolum">Eşleşmeler (@_listeler.Eslesmeler.Count)</h2>
    @foreach (var e in _listeler.Eslesmeler)
    {
        <KisiKarti Ad="@e.AdSoyad" Satirlar="@([.. Satirlar(e), $"İletişim: {e.Eposta}"])" Uyum="e.UyumYuzdesi">
            <Ek>
                @if (_acikKonusma == e.KisiId)
                {
                    <MesajPaneli KisiId="e.KisiId" KisiAdi="@e.AdSoyad" />
                }
            </Ek>
            <Eylemler>
                <span class="durum basari">✓ Eşleştiniz</span>
                <button class="ikincil" @onclick="() => KonusmaAc(e.KisiId)">@(_acikKonusma == e.KisiId ? "Mesajları kapat" : "Mesajlar")</button>
            </Eylemler>
        </KisiKarti>
    }
    @if (_listeler.Eslesmeler.Count == 0)
    {
        <div class="bos">Henüz eşleşmen yok.</div>
    }
}

@code {
    private EslesmeListeleri? _listeler;
    private int? _acikKonusma;

    protected override Task OnInitializedAsync() => Dene(Yukle);

    private async Task Yukle() => _listeler = await U.Eslesmeler();

    private static List<string> Satirlar(EslesmeOzeti e) =>
        [$"{e.Bolum} · {e.Sehir}", $"Tarih: {Arayuz.Tarih(e.Tarih)}"];

    private void KonusmaAc(int kisiId) => _acikKonusma = _acikKonusma == kisiId ? null : kisiId;

    private async Task Yanitla(EslesmeOzeti e, bool kabul)
    {
        if (await Dene(async () => { await U.Yanitla(e.EslesmeId, kabul); await Yukle(); }))
            Bilgi = kabul ? $"{e.AdSoyad} ile eşleştiniz. Artık mesajlaşabilirsiniz." : $"{e.AdSoyad} kişisinin isteği reddedildi.";
    }

    private async Task GeriCek(EslesmeOzeti e)
    {
        if (await Dene(async () => { await U.GeriCek(e.EslesmeId); await Yukle(); }))
            Bilgi = $"{e.AdSoyad} kişisine gönderilen istek geri çekildi.";
    }
}
