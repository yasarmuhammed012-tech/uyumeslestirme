<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UyumEslestirme.Business\UyumEslestirme.Business.csproj" />
  </ItemGroup>

  <!-- Tarayicida SQLite kullanilmaz (bellek ici veritabani); Data katmanindan gelen yerel SQLite kutuphanesi baglanmaz. -->
  <Target Name="YerelSqliteKutuphanesiniCikar" BeforeTargets="_CheckBrowserWorkloadNeededButNotAvailable;Build" Condition="'@(NativeFileReference)' != ''">
    <ItemGroup>
      <NativeFileReference Remove="@(NativeFileReference)" />
    </ItemGroup>
  </Target>

</Project>
