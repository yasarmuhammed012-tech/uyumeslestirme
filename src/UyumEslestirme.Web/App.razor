@implements IDisposable
@inject IUygulama U

<CascadingValue Value="this" IsFixed="true">
    @if (!U.Acik)
    {
        <div class="giris-zemin">
            <div class="giris-kutu">
                <section class="marka-panel">
                    <div class="logo">⌂</div>
                    <h1>Uyum Eşleştirme</h1>
                    <p>Yaşam tarzına uygun ev ve yurt arkadaşını bul.</p>
                    <ul>
                        <li>Profilini oluştur, tercih anketini doldur</li>
                        <li>Diğer öğrencilerle uyum yüzdeni gör</li>
                        <li>İstek gönder, karşılıklı kabulde eşleş</li>
                    </ul>
                </section>
                <section class="form-panel">
                    @if (_kayit)
                    {
                        <KayitSayfasi Tamamlandi="KayitTamamlandi" Vazgec="() => _kayit = false" />
                    }
                    else
                    {
                        <GirisSayfasi KayitAc="KayitAc" GirisYapildi="GirisYapildi" Mesaj="@_girisMesaji" />
                    }
                </section>
            </div>
            <p class="demo-notu">
                @UygulamaSurumu.Metin ·
                @if (U.GercekVeritabani)
                {
                    <text>Sunucu sürümü: hesaplar ve veriler sunucudaki veritabanında kalıcı olarak saklanır.</text>
                }
                else
                {
                    <text>Web demosu: veriler yalnızca bu tarayıcı sekmesinde tutulur, sayfa yenilenince demo verilere döner.</text>
                }
            </p>
        </div>
    }
    else
    {
        <div class="kabuk">
            <aside class="kenar">
                <div class="marka"><span class="logo kucuk">⌂</span> Uyum Eşleştirme</div>
                <div class="kullanici">
                    <div class="avatar">@Arayuz.BasHarfler(U.AdSoyad)</div>
                    <div>
                        <b>@U.AdSoyad</b>
                        <span>@Arayuz.RolAdi(U.Rol)</span>
                    </div>
                </div>
                <nav>
                    @foreach (var (ad, sayfa) in Menu())
                    {
                        <button class="@(sayfa == _sayfa ? "secili" : null)" @onclick="() => SayfaAc(sayfa)">
                            @ad
                            @if (sayfa == Sayfa.Bildirimler && _okunmamis > 0)
                            {
                                <span class="rozet" aria-label="okunmamış bildirim">@_okunmamis</span>
                            }
                        </button>
                    }
                </nav>
                <button class="cikis" @onclick="CikisYap">Çıkış yap</button>
                <span class="surum">@UygulamaSurumu.Metin · @(U.GercekVeritabani ? "sunucu" : "demo")</span>
            </aside>
            <main class="icerik">
                @switch (_sayfa)
                {
                    case Sayfa.Profil: <ProfilSayfasi />; break;
                    case Sayfa.Anket: <AnketSayfasi />; break;
                    case Sayfa.Oneriler: <OnerilerSayfasi />; break;
                    case Sayfa.Adaylar: <AdaylarSayfasi />; break;
                    case Sayfa.Eslesmeler: <EslesmelerSayfasi />; break;
                    case Sayfa.Bildirimler: <BildirimlerSayfasi />; break;
                    case Sayfa.Yonetim: <YonetimSayfasi />; break;
                }
            </main>
        </div>
    }
</CascadingValue>

@code {
    public enum Sayfa { Profil, Anket, Oneriler, Adaylar, Eslesmeler, Bildirimler, Yonetim }

    private bool _kayit;
    private string? _girisMesaji;
    private Sayfa _sayfa = Sayfa.Profil;
    private int _okunmamis;
    private Timer? _zamanlayici;

    protected override void OnInitialized() =>
        _zamanlayici = new Timer(_ => InvokeAsync(Denetle), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));

    // Rol kontrolu is katmanindadir; menu yalnizca kullaniciya uygun sayfalari gosterir.
    private IEnumerable<(string, Sayfa)> Menu()
    {
        yield return ("Profil", Sayfa.Profil);
        yield return ("Tercih anketi", Sayfa.Anket);
        if (U.Rol == Rol.Ogrenci)
        {
            yield return ("Önerilenler", Sayfa.Oneriler);
            yield return ("Arkadaş bul", Sayfa.Adaylar);
            yield return ("Eşleşmelerim", Sayfa.Eslesmeler);
        }
        yield return ("Bildirimler", Sayfa.Bildirimler);
        if (U.Rol == Rol.Yonetici)
            yield return ("Yönetim", Sayfa.Yonetim);
    }

    private async Task SayfaAc(Sayfa sayfa)
    {
        _sayfa = sayfa;
        await BildirimSayisiniYenile();
    }

    public async Task BildirimSayisiniYenile()
    {
        if (!U.Acik)
            return;
        try
        {
            _okunmamis = await U.OkunmamisBildirim();
            StateHasChanged();
        }
        catch (Exception h) when (h is IsKuraliHatasi or YetkisizErisimHatasi)
        {
            // Rozet yalnizca bilgi amaclidir; hata sayfa akisini bozmaz.
        }
    }

    public async Task OturumBitti(string mesaj)
    {
        await U.CikisYap();
        _girisMesaji = mesaj;
        StateHasChanged();
    }

    // 30 saniyede bir: oturum suresi doldu mu, yeni bildirim var mi?
    private async Task Denetle()
    {
        if (!U.Acik && U.AdSoyad != "")
        {
            await OturumBitti("Oturum süreniz doldu. Lütfen tekrar giriş yapın.");
            return;
        }
        await BildirimSayisiniYenile();
    }

    private async Task GirisYapildi()
    {
        _girisMesaji = null;
        _sayfa = Sayfa.Profil;
        await BildirimSayisiniYenile();
    }

    private void KayitAc()
    {
        _girisMesaji = null;
        _kayit = true;
    }

    private void KayitTamamlandi()
    {
        _kayit = false;
        _girisMesaji = "Kayıt tamamlandı. Şimdi giriş yapabilirsiniz.";
    }

    private async Task CikisYap()
    {
        await U.CikisYap();
        _girisMesaji = null;
        _okunmamis = 0;
    }

    public void Dispose() => _zamanlayici?.Dispose();
}
